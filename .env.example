# Copy to .env for local development: cp .env.example .env
# Never commit .env — it is git-ignored (docs/15-security-design.md).

# Process role: all | api | worker | scheduler
PROXUI_ROLE=all
PROXUI_ENV=dev

# Listeners
PROXUI_HTTP_ADDR=:8080
PROXUI_METRICS_ADDR=:9090

# Dependencies (match deploy/compose/docker-compose.dev.yml)
PROXUI_DATABASE_URL=postgres://proxui:proxui@127.0.0.1:5432/proxui?sslmode=disable
PROXUI_REDIS_URL=redis://127.0.0.1:6379/0

# Logging: level debug|info|warn|error, format json|console
PROXUI_LOG_LEVEL=debug
PROXUI_LOG_FORMAT=console

# Apply pending migrations on startup (API role only)
PROXUI_MIGRATE_ON_START=true

# The name this portal is served at from outside, e.g. vm.example.com.
# Not used for routing: it is how the portal recognises its own rule in an
# edge provider's routing table so that no change can delete or shadow it
# (docs/28, PUB-33). Leave empty if the portal is not published through a
# provider the portal manages — the guard then stays off.
PROXUI_PUBLIC_HOSTNAME=
